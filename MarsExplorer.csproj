<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MarsExplorer</AssemblyName>
    <RootNamespace>MarsExplorer</RootNamespace>
    <!-- Lets the project restore/build on non-Windows machines too (e.g. CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
	<ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>

	<Compile Update="MainWindow.Camera.cs">
	  <DependentUpon>MainWindow.xaml</DependentUpon>
	</Compile>
	<Compile Update="MainWindow.Menus.cs">
	  <DependentUpon>MainWindow.xaml</DependentUpon>
	</Compile>
	<Compile Update="MainWindow.MouseKeyboard.cs">
	  <DependentUpon>MainWindow.xaml</DependentUpon>
	</Compile>
	<Compile Update="MainWindow.Statusbar.cs">
	  <DependentUpon>MainWindow.xaml</DependentUpon>
	</Compile>
  </ItemGroup>

</Project>
