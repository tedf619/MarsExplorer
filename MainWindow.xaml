<Window x:Class="MarsExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mars Explorer" Width="1200" Height="800" Background="Black"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="MenuItemViewFileExit_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Reset view" InputGestureText="R" Click="MenuItemViewResetView_Click"/>
        <MenuItem Header="Zoom _in" InputGestureText="+" Click="MenuItemViewZoomIn_Click"/>
        <MenuItem Header="Zoom _out" InputGestureText="-" Click="MenuItemViewZoomOut_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem DockPanel.Dock="Right">
        <TextBlock x:Name="StatusBarMessage" Foreground="DarkRed" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
      </StatusBarItem>
      <StatusBarItem>
        <TextBlock x:Name="StatusBarAltitude" Text="Altitude: –" MinWidth="130"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="StatusBarCursorPosition" Text="Latitude: 0.0000  Longitude: 0.0000" MinWidth="230"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="TilesText" Text="Tiles: –"/>
      </StatusBarItem>
    </StatusBar>

    <Grid x:Name="ViewHost" Background="Black" ClipToBounds="True"
              MouseWheel="ViewHost_MouseWheel"
              MouseMove="ViewHost_MouseMove"
              MouseLeftButtonDown="ViewHost_MouseLeftButtonDown"
              MouseLeftButtonUp="ViewHost_MouseLeftButtonUp">
      <Viewport3D x:Name="Viewport" ClipToBounds="True" IsHitTestVisible="False">
        <Viewport3D.Camera>
          <PerspectiveCamera x:Name="Cam" Position="0,0,0" LookDirection="0,0,-1" UpDirection="0,1,0"
                                       FieldOfView="45" NearPlaneDistance="1" FarPlaneDistance="1000000"/>
        </Viewport3D.Camera>
        <ModelVisual3D x:Name="SceneRoot"/>
      </Viewport3D>

      <TextBlock x:Name="Overlay" Foreground="White" FontSize="16" TextWrapping="Wrap" MaxWidth="640"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

      <TextBlock x:Name="CreditText" Foreground="#FFD0D0D0" FontSize="11" Margin="0,0,8,6"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                       Text="Mars data: Cesium ion, NASA, ESA, USGS" ForceCursor="True" Background="#FF101010" Padding="8,0,8,0"/>
    </Grid>
  </DockPanel>
</Window>
